#!/usr/bin/env python3
"""
Create an M3U playlist from all video files found under a given directory.

Usage:
    python playlist_generator.py /path/to/start [output_playlist.m3u]

If the output playlist path is omitted, a file named “playlist.m3u” will be
created inside the start directory.
"""
import argparse
import os
import sys
from pathlib import Path

# ----------------------------------------------------------------------
# Configurable set of video extensions (case‑insensitive)
# ----------------------------------------------------------------------
VIDEO_EXTENSIONS = {
    ".mp4",
    ".mkv",
    ".avi",
    ".mov",
    ".flv",
    ".wmv",
    ".webm",
    ".mpeg",
    ".mpg",
    ".m4v",
    ".3gp",
    ".3g2",
}


def is_video_file(path: Path) -> bool:
    """Return True if *path* points to a file with a known video extension."""
    return path.is_file() and path.suffix.lower() in VIDEO_EXTENSIONS


def collect_video_files(root: Path) -> list[Path]:
    """
    Walk *root* recursively and return a list of Paths to video files.
    The list is sorted alphabetically to give a stable playlist order.
    """
    video_paths = []
    for dirpath, _, filenames in os.walk(root):
        for fname in filenames:
            candidate = Path(dirpath) / fname
            if is_video_file(candidate):
                video_paths.append(candidate.resolve())
    video_paths.sort()
    return video_paths


def folder_round_robin(video_paths: list[Path]) -> list[Path]:
    """
    Reorder *video_paths* by grouping files by their parent folder and then
    interleaving the groups in round-robin fashion.

    Groups are visited in sorted order of their parent folder; within each
    group files keep their sorted order. When a group is exhausted it is
    skipped and the remaining groups continue to round-robin until every file
    has been placed.

    Args:
        video_paths: Video file paths, assumed already sorted.

    Returns:
        The video paths reordered in round-robin order.
    """
    groups: dict[Path, list[Path]] = {}
    for video in video_paths:
        groups.setdefault(video.parent, []).append(video)

    ordered_groups = [groups[parent] for parent in sorted(groups)]

    result: list[Path] = []
    index = 0
    while ordered_groups:
        index %= len(ordered_groups)
        result.append(ordered_groups[index].pop(0))
        if not ordered_groups[index]:
            del ordered_groups[index]
        else:
            index += 1
    return result


def write_m3u_playlist(video_paths: list[Path], playlist_path: Path) -> None:
    """Write an M3U playlist (UTF‑8) with the supplied video file paths."""
    with playlist_path.open("w", encoding="utf-8") as f:
        f.write("#EXTM3U\n")  # standard header
        for video in video_paths:
            # Optional: you could add an #EXTINF line with duration & title.
            f.write(f"{video}\n")
    print(f"Playlist written to: {playlist_path}")


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Recursively generate an M3U playlist of video files."
    )
    parser.add_argument(
        "start_dir",
        nargs="?",
        type=Path,
        default=Path.cwd(),
        help="Directory to start the recursive search. Defaults to the current directory.",
    )
    parser.add_argument(
        "output",
        nargs="?",
        type=Path,
        help=(
            "Output .m3u file. " "If omitted, '<start_dir>/playlist.m3u' will be used."
        ),
    )
    parser.add_argument(
        "--mode",
        choices=["file-order", "folder-round-robin"],
        default="file-order",
        help=(
            "Playlist ordering mode. 'file-order' (default) lists files in "
            "sorted order. 'folder-round-robin' interleaves files from each "
            "parent folder in round-robin order."
        ),
    )
    return parser.parse_args()


def main() -> None:
    args = parse_args()
    start_dir: Path = args.start_dir.resolve()

    if not start_dir.is_dir():
        sys.exit(f"Error: '{start_dir}' is not a directory.")

    playlist_path = args.output.resolve() if args.output else start_dir / "playlist.m3u"

    video_files = collect_video_files(start_dir)

    if not video_files:
        sys.exit("No video files found – nothing to write.")

    if args.mode == "folder-round-robin":
        video_files = folder_round_robin(video_files)

    write_m3u_playlist(video_files, playlist_path)


if __name__ == "__main__":
    main()
