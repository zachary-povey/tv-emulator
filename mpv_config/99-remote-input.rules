# 1. Interface 02 (Main Keyboard): Force as keyboard
SUBSYSTEM=="input", ATTRS{idVendor}=="1915", ATTRS{idProduct}=="1025", ATTRS{bInterfaceNumber}=="02", ENV{ID_INPUT_KEYBOARD}="1", ENV{ID_INPUT_MOUSE}="0"

# 2. Interface 03 (The Composite Part):
# This interface spawns two nodes: a Mouse node and a Volume node.
# We match ONLY the node that has the "MOUSE" tag and wipe its identity.
SUBSYSTEM=="input", ATTRS{idVendor}=="1915", ATTRS{idProduct}=="1025", ATTRS{bInterfaceNumber}=="03", ENV{ID_INPUT_MOUSE}=="1", ENV{ID_INPUT}=""