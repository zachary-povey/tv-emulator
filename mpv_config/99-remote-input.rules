# 1. Interface 02 (Keyboard): Force as keyboard, ensure no mouse ghosting.
SUBSYSTEM=="input", ATTRS{idVendor}=="1915", ATTRS{idProduct}=="1025", ATTRS{bInterfaceNumber}=="02", ENV{ID_INPUT_KEYBOARD}="1", ENV{ID_INPUT_MOUSE}="0"

# 2. Interface 03 (Mouse Node): If it claims to be a mouse, IGNORE it.
# This targets the specific 'event' node that handles the cursor.
SUBSYSTEM=="input", ATTRS{idVendor}=="1915", ATTRS{idProduct}=="1025", ATTRS{bInterfaceNumber}=="03", ENV{ID_INPUT_MOUSE}=="1", ENV{LIBINPUT_IGNORE_DEVICE}="1"

# 3. Interface 03 (Key Node): If it is NOT a mouse (the volume keys), treat as Keyboard.
# This ensures the volume buttons on this interface are picked up.
SUBSYSTEM=="input", ATTRS{idVendor}=="1915", ATTRS{idProduct}=="1025", ATTRS{bInterfaceNumber}=="03", ENV{ID_INPUT_MOUSE}!="1", ENV{ID_INPUT_KEYBOARD}="1"